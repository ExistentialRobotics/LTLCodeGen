<launch>

    <arg name="world" default="office"/>
    <arg name="want_gui" default="false"/>
    <arg name="sim" default="true"/>
    <arg name="robot_name" default="husky_1"/>
    <arg name="active_mapping" default="true"/>

    <!-- Launch the corresponding environment if sim otherwise don't launch-->
    <group if="$(arg sim)">
        <include file="$(find jackal_solar_sim)/launch/launch_jackal_$(arg world).launch">
            <arg name="want_gui" value="$(arg want_gui)"/>
            <arg name="robot_name" value="$(arg robot_name)"/>
        </include>
    </group>

    <!-- Launch SSMI Mapping -->
    <!-- if sim, set world_frame_id to world -->
    <group if="$(arg sim)">
        <include file="$(find semantic_octomap)/launch/semantic_octomap.launch">
            <arg name="world_frame_id" value="world"/>
        </include>
    </group>
    <group unless="$(arg sim)">
        <include file="$(find semantic_octomap)/launch/semantic_octomap.launch"/>
    </group>

    <!-- Launch SSMI Planning -->
    <group if="$(arg active_mapping)">
        <include file="$(find semantic_info_gathering)/launch/run_semantic_exploration.launch">
            <arg name="rviz" value="false"/>
        </include>
        <node pkg="car_control" type="cone_controller_node.py" name="cone_controller"  output="screen">
          <param name="odom_topic" value="/$(arg robot_name)/pose"/>
          <param name="odom_type" value="poseS"/>
          <param name="setpoint_topic" value="/planner/position_cmd"/>
          <param name="setpoint_type" value="poseS"/>
          <remap from="/cmd_vel" to="/$(arg robot_name)/cmd_vel" />
          <param name="ctrl_freq" value="50.0"/>
          <param name="kv" value="0.5"/>
          <param name="kw" value="1.5"/>
          <!-- Control limits are set as the same as in control.yaml in jackal_control package -->
          <!-- linear velocity limit m/sec-->
          <param name="v_min" value="-2.0"/>
          <param name="v_max" value="2.0"/>
          <!-- angular velocity limit rad/sec-->
          <param name="w_min" value="-4.0"/>
          <param name="w_max" value="4.0"/>
        </node>
    </group>

    <!-- Rviz -->
    <node type="rviz" name="rviz" pkg="rviz" args="-d $(find jackal_solar_sim)/rviz/mapping.rviz"/>

</launch>
