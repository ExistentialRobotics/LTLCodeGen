<?xml version="1.0"?>
<package format="3">
  <name>solar_planner</name>
  <version>0.1.0</version>
  <description>The solar_planner package (ROS 2)</description>

  <maintainer email="brabiei@todo.todo">brabiei</maintainer>
  <license>TODO</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- System/third-party deps resolved via rosdep -->
  <depend>yaml-cpp</depend>
  <depend>nlohmann_json</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
